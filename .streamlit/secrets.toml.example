# ============================================================
# Streamlit Secrets - Configuración de Base de Datos
# ============================================================
# Copia este archivo como secrets.toml (sin .example)
# IMPORTANTE: secrets.toml NO debe versionarse en git

# ============================================================
# OPCIÓN 1: SQLite (Predeterminado)
# ============================================================
# No requiere configuración - simplemente no definas DATABASE_URL
# El sistema usará automáticamente: crm_exo_v2/data/crm_exo_v2.sqlite

# ============================================================
# OPCIÓN 2: PostgreSQL (Producción)
# ============================================================
# Descomenta y configura tu DATABASE_URL:

DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Ejemplos según proveedor:

# Neon.tech (gratuito hasta 10GB)
# DATABASE_URL = "postgresql://user:AbC123@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Render.com
# DATABASE_URL = "postgresql://user:AbC123@dpg-xxxxx.oregon-postgres.render.com/crm_db"

# Railway.app
# DATABASE_URL = "postgresql://postgres:AbC123@containers-us-west-xxx.railway.app:5432/railway"

# Supabase
# DATABASE_URL = "postgresql://postgres:AbC123@db.xxxxx.supabase.co:5432/postgres"

# ============================================================
# OTRAS CONFIGURACIONES (Opcional)
# ============================================================

# Token PAC para CFDI
# CFDI_PAC_TOKEN = "tu_token_timbracfdi33"
# CFDI_MODE = "produccion"  # pruebas o produccion

# Ambiente
# ENVIRONMENT = "production"  # development, staging, production
