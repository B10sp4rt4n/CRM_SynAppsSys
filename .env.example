# ============================================================
# Variables de Entorno - CRM-EXO v2
# ============================================================
# Copia este archivo como .env (sin .example) y configura tus valores
# IMPORTANTE: .env NO debe versionarse en git

# ============================================================
# BASE DE DATOS
# ============================================================

# OPCIÓN 1: SQLite (Predeterminado - no requiere configuración)
# Si no defines DATABASE_URL, se usa: crm_exo_v2/data/crm_exo_v2.sqlite

# OPCIÓN 2: PostgreSQL (Producción)
# Descomenta y configura:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# Ejemplos de proveedores cloud:
# Neon.tech: postgresql://user:AbC123@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Render: postgresql://user:AbC123@dpg-xxxxx.oregon-postgres.render.com/crm_db
# Railway: postgresql://postgres:AbC123@containers-us-west-xxx.railway.app:5432/railway
# Supabase: postgresql://postgres:AbC123@db.xxxxx.supabase.co:5432/postgres

# ============================================================
# CFDI / FACTURACIÓN (Opcional - alternativo a secrets.toml)
# ============================================================
# CFDI_PAC_TOKEN=tu_token_timbracfdi33
# CFDI_MODE=produccion  # pruebas o produccion

# ============================================================
# APLICACIÓN
# ============================================================
# ENVIRONMENT=development  # development, staging, production
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
# DEBUG=false
